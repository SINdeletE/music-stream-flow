@startuml

' Dimentions
entity dim_device {
    * device_sk: int <<PK>>
    --
    * device_name: varchar(128)
    * device_version: varchar(16)
    * device_os_name: varchar(32)
    * device_os_version: varchar(32)

    * loaded_at: timestamptz
    * updated_at: timestamptz
    deleted_at: timestamptz

}

entity dim_app_release {
    * app_release_sk: int <<PK>>
    --
    * app_release_id: varchar(64)
    * platform: varchar(16)
    * app_release_version: varchar(16)
    * build: varchar(32)
    * released_at: timestamptz

    * loaded_at: timestamptz
    * updated_at: timestamptz
    deleted_at: timestamptz

}

entity dim_track {
    * track_sk: int <<PK>>
    --
    * track_id: varchar(64)
    * name: varchar(255)
    * duration_ms: int
    * is_available: boolean = false
    * track_created_at: timestamptz
    track_deleted_at: timestamptz

    * loaded_at: timestamptz
    * updated_at: timestamptz
    deleted_at: timestamptz
}

entity dim_artist {
    * artist_sk: int <<PK>>
    --
    * artist_id: varchar(64)
    * nickname: varchar(255)
    name: varchar(255)
    middle_name: varchar(255)
    last_name: varchar(255)
    country_code: varchar(2)
    biography: varchar(512)
    * is_verified: boolean
    * created_at: timestamptz
    deleted_at: timestamptz

    * loaded_at: timestamptz
    * updated_at: timestamptz
    deleted_at: timestamptz
}

entity dim_genre {
    * genre_sk: int <<PK>>
    --
    * genre_id: varchar(64)
    * name: varchar(64)

    * loaded_at: timestamptz
    * updated_at: timestamptz
    deleted_at: timestamptz
}

entity dim_release {
    * release_sk: int <<PK>>
    --
    * release_id: varchar(64)
    * name: varchar(255)
    * is_available: boolean = false
    * released_at: timestamptz

    * loaded_at: timestamptz
    * updated_at: timestamptz
    deleted_at: timestamptz
}

entity dim_event_type {
    * event_type_sk: int <<PK>>
    --
    * name: varchar(64)

    * loaded_at: timestamptz
    * updated_at: timestamptz
    deleted_at: timestamptz
}

' Bridges
entity brg_device_app_release {
    * device_sk: int <<PK, FK>>
    * app_release_sk: int <<PK, FK>>
    --

    * loaded_at: timestamptz
}

entity brg_track_genre {
    * track_sk: int <<PK, FK>>
    * genre_sk: int <<PK, FK>>
    --
}

entity brg_track_artist {
    * track_sk: int <<PK, FK>>
    * artist_sk: int <<PK, FK>>
    --
    * artist_number: int
}

entity brg_track_release {
    * track_sk: int <<PK, FK>>
    * release_sk: int <<PK, FK>>
    --
    * track_number: int
    disc_number: int
}

entity brg_artist_release {
    * artist_sk: int <<PK, FK>>
    * release_sk: int <<PK, FK>>
    --
    * artist_number: int
}

' Fact
entity fct_events {
    * event_sk: int <<PK>>
    --
    * event_type_sk: int <<FK>>
    * device_sk: int <<FK>>
    * app_release_sk: int <<FK>>
    * installation_sk: int <<FK>>
    * track_sk: int <<FK>>

    * event_timestamp: timestamptz
    * received_at: timestamptz
    * loaded_at: timestamptz
    * updated_at: timestamptz
}
' Fact to dimensions (including Unknown / Not applicable members)
dim_event_type ||--o{ fct_events : event_type_sk
dim_device ||--o{ fct_events : device_sk
dim_app_release ||--o{ fct_events : app_release_sk
dim_installation ||--o{ fct_events : installation_sk
dim_track ||--o{ fct_events : track_sk

' Dimensions to bridges
dim_device ||--|{ brg_device_app_release : device_sk
dim_app_release ||--o{ brg_device_app_release : app_release_sk

dim_track ||--|{ brg_track_genre : track_sk
dim_genre ||--o{ brg_track_genre : genre_sk

dim_track ||--|{ brg_track_artist : track_sk
dim_artist ||--o{ brg_track_artist : artist_sk

dim_track ||--|{ brg_track_release : track_sk
dim_release ||--o{ brg_track_release : release_sk

dim_artist ||--|{ brg_artist_release : artist_sk
dim_release ||--o{ brg_artist_release : release_sk

@enduml

@startuml

' Source: sql/dwh/ddl/01-create.sql. Distributed aliases use the same columns.
' PK / FK denote logical relationships; ClickHouse does not enforce uniqueness or FKs.
' * denotes a non-nullable SQL column; generated SKs can be omitted from INSERT.

legend left
  Types are ClickHouse types.
  <<generated>> = DEFAULT generateSerialID()
  Dotted relationships link rows to their ETL load.
endlegend

' Dimensions

entity dim_device {
    * device_sk: BIGINT <<PK, generated>>
    --
    * device_id: UUID
    * user_id: UUID
    * name: String
    * device_version: String

    * load_id: UUID <<FK>>
    * source_created_at: DateTime64(3, 'UTC')
    * updated_at: DateTime64(3, 'UTC')
}

entity dim_device_os {
    * device_os_sk: BIGINT <<PK, generated>>
    --
    * device_os_id: UUID
    * name: String
    * device_os_version: String
    * valid_from: DateTime64(3, 'UTC')

    * load_id: UUID <<FK>>
    * source_created_at: DateTime64(3, 'UTC')
}

entity dim_app_release {
    * app_release_sk: BIGINT <<PK, generated>>
    --
    * app_release_id: UUID
    * platform: String
    * app_release_version: String
    * build: String
    * released_at: DateTime64(3, 'UTC')

    * load_id: UUID <<FK>>
    * source_created_at: DateTime64(3, 'UTC')
}

entity dim_track {
    * track_sk: BIGINT <<PK, generated>>
    --
    * track_id: UUID
    * name: String
    * duration_ms: Int32
    * is_available: Bool = false

    * load_id: UUID <<FK>>
    * source_created_at: DateTime64(3, 'UTC')
    * updated_at: DateTime64(3, 'UTC')
    deleted_at: Nullable(DateTime64(3, 'UTC'))
}

entity dim_artist {
    * artist_sk: BIGINT <<PK, generated>>
    --
    * artist_id: UUID
    * nickname: String
    name: Nullable(String)
    middle_name: Nullable(String)
    last_name: Nullable(String)
    country_code: Nullable(String)
    biography: Nullable(String)
    * is_verified: Bool

    * load_id: UUID <<FK>>
    * source_created_at: DateTime64(3, 'UTC')
    * updated_at: DateTime64(3, 'UTC')
    deleted_at: Nullable(DateTime64(3, 'UTC'))
}

entity dim_genre {
    * genre_sk: BIGINT <<PK, generated>>
    --
    * genre_id: UUID
    * name: String

    * load_id: UUID <<FK>>
    * source_created_at: DateTime64(3, 'UTC')
    * updated_at: DateTime64(3, 'UTC')
    deleted_at: Nullable(DateTime64(3, 'UTC'))
}

entity dim_release {
    * release_sk: BIGINT <<PK, generated>>
    --
    * release_id: UUID
    * name: String
    * is_available: Bool = false
    * released_at: DateTime64(3, 'UTC')

    * load_id: UUID <<FK>>
    * source_created_at: DateTime64(3, 'UTC')
    * updated_at: DateTime64(3, 'UTC')
    deleted_at: Nullable(DateTime64(3, 'UTC'))
}

entity dim_event_type {
    * event_type_sk: BIGINT <<PK, generated>>
    --
    * name: String
    * load_id: UUID <<FK>>
    * updated_at: DateTime64(3, 'UTC')
    deleted_at: Nullable(DateTime64(3, 'UTC'))
}

' Bridges

entity brg_device_app_release {
    * device_sk: BIGINT <<PK, FK>>
    * app_release_sk: BIGINT <<PK, FK>>

    * load_id: UUID <<FK>>
}

entity brg_track_genre {
    * track_sk: BIGINT <<PK, FK>>
    * genre_sk: BIGINT <<PK, FK>>

    * load_id: UUID <<FK>>
}

entity brg_track_artist {
    * track_sk: BIGINT <<PK, FK>>
    * artist_sk: BIGINT <<PK, FK>>
    * artist_number: Int32

    * load_id: UUID <<FK>>
}

entity brg_track_release {
    * track_sk: BIGINT <<PK, FK>>
    * release_sk: BIGINT <<PK, FK>>
    * track_number: Int32
    disc_number: Nullable(Int32)

    * load_id: UUID <<FK>>
}

entity brg_artist_release {
    * artist_sk: BIGINT <<PK, FK>>
    * release_sk: BIGINT <<PK, FK>>
    * artist_number: Int32

    * load_id: UUID <<FK>>
}

' Fact

entity fct_events {
    * event_sk: BIGINT <<PK, generated>>
    --
    * event_id: UUID
    * event_type_sk: BIGINT <<FK>>
    * device_sk: BIGINT <<FK>>
    * device_os_sk: BIGINT <<FK>>
    * app_release_sk: BIGINT <<FK>>
    * track_sk: BIGINT <<FK>>
    * session_id: UUID

    playback_id: Nullable(UUID)
    * event_timestamp: DateTime64(3, 'UTC')
    * received_at: DateTime64(3, 'UTC')
    * load_id: UUID <<FK>>
    * updated_at: DateTime64(3, 'UTC')
}

' Load audit

entity etl_loads {
    * load_id: UUID <<PK>>
    --
    * dag_id: String
    * run_id: String
    * task_id: String

    * source_system: String
    * target_table: String

    * interval_start: DateTime64(3, 'UTC')
    * interval_end: DateTime64(3, 'UTC')
    * started_at: DateTime64(3, 'UTC')
    finished_at: Nullable(DateTime64(3, 'UTC'))

    * state: LowCardinality(String)
    * rows_read: UInt64
    * rows_written: UInt64
    * rows_rejected: UInt64

    error_msg: Nullable(String)
}

' Fact to dimensions (including Unknown / Not applicable members)
dim_event_type ||--o{ fct_events : event_type_sk
dim_device ||--o{ fct_events : device_sk
dim_device_os ||--o{ fct_events : device_os_sk
dim_app_release ||--o{ fct_events : app_release_sk
dim_track ||--o{ fct_events : track_sk

' Dimensions to bridges
dim_device ||--o{ brg_device_app_release : device_sk
dim_app_release ||--o{ brg_device_app_release : app_release_sk

dim_track ||--o{ brg_track_genre : track_sk
dim_genre ||--o{ brg_track_genre : genre_sk

dim_track ||--o{ brg_track_artist : track_sk
dim_artist ||--o{ brg_track_artist : artist_sk

dim_track ||--o{ brg_track_release : track_sk
dim_release ||--o{ brg_track_release : release_sk

dim_artist ||--o{ brg_artist_release : artist_sk
dim_release ||--o{ brg_artist_release : release_sk

' Load audit relationships (logical, not SQL foreign key constraints)
etl_loads ||..o{ dim_device : load_id
etl_loads ||..o{ dim_device_os : load_id
etl_loads ||..o{ dim_app_release : load_id
etl_loads ||..o{ dim_track : load_id
etl_loads ||..o{ dim_artist : load_id
etl_loads ||..o{ dim_genre : load_id
etl_loads ||..o{ dim_release : load_id
etl_loads ||..o{ dim_event_type : load_id
etl_loads ||..o{ brg_device_app_release : load_id
etl_loads ||..o{ brg_track_genre : load_id
etl_loads ||..o{ brg_track_artist : load_id
etl_loads ||..o{ brg_track_release : load_id
etl_loads ||..o{ brg_artist_release : load_id
etl_loads ||..o{ fct_events : load_id

@enduml

@startuml C4-L1-music-stream-flow
!include <C4/C4_Container>
Person(userAlias, "User", "Service user")

System_Boundary(musicaAlias, "Musica", "Music Service") {
    Container(musicaWebAppAlias, "Web App", "-",  "Musica web app")
    Container(musicaIOSAlias, "iOS App", "-",  "Musica web app")
    Container(musicaAndroidAlias, "Android App", "-",  "Musica web app")
    Container(musicaDesktopAlias, "Desktop App", "-",  "Musica web app")

    Container(musicaBackendAlias, "Backend", "-", "Musica backend")

    Container(musicaDatabaseAlias, "OLTP Database", "PostgreSQL", "Musica OLTP Database")
}

System_Boundary(musicStreamFlowAlias, "Music stream flow", "Musica Analytics Service") {
    Container(musicaAnalyticsCollectorAlias, "Analytics Collector", "HTTPS API", "Receives analytics events from clients and backend and publishes them to Kafka")

    Container(musicaDWHDatabaseAlias, "DWH Database", "Clickhouse", "Musica Analytics DWH Database")

    Container(musicaEventBusDatabaseAlias, "Analytics event bus", "Kafka", "Musica Analytics event bus")
    Container(musicaPipelineOrchestratorDatabaseAlias, "Data Pipeline Orchestrator", "Airflow", "Musica Pipeline orchestrator")
}

Rel(userAlias, musicaWebAppAlias, "Uses")
Rel(userAlias, musicaIOSAlias, "Uses")
Rel(userAlias, musicaAndroidAlias, "Uses")
Rel(userAlias, musicaDesktopAlias, "Uses")

Rel(musicaWebAppAlias, musicaBackendAlias, "Uses")
Rel(musicaIOSAlias, musicaBackendAlias, "Uses")
Rel(musicaAndroidAlias, musicaBackendAlias, "Uses")
Rel(musicaDesktopAlias, musicaBackendAlias, "Uses")

Rel(musicaWebAppAlias, musicaAnalyticsCollectorAlias, "Sends analytics\nevents", "HTTPS")
Rel(musicaIOSAlias, musicaAnalyticsCollectorAlias, "Sends analytics\nevents", "HTTPS")
Rel(musicaAndroidAlias, musicaAnalyticsCollectorAlias, "Sends analytics\nevents", "HTTPS")
Rel(musicaDesktopAlias, musicaAnalyticsCollectorAlias, "Sends analytics\nevents", "HTTPS")

Rel(musicaBackendAlias, musicaDatabaseAlias, "Read/Write")

Rel(musicaPipelineOrchestratorDatabaseAlias, musicaDatabaseAlias, "Get lookup tables")
Rel(musicaPipelineOrchestratorDatabaseAlias, musicaDWHDatabaseAlias, "Actualize lookup tables/Add events")
Rel(musicaBackendAlias, musicaAnalyticsCollectorAlias, "Sends server-side analytics events", "HTTPS")
Rel(musicaAnalyticsCollectorAlias, musicaEventBusDatabaseAlias, "Publishes analytics events", "Kafka protocol")

Rel(musicaPipelineOrchestratorDatabaseAlias, musicaEventBusDatabaseAlias, "Get events for analytics")
@enduml

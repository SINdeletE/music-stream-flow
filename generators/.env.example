# OLTP generator: Docker uses the service hostname and internal PostgreSQL port.
# For a local Python process use localhost and the published PostgreSQL port.
OLTP_HOST=music-oltp
OLTP_PORT=5432
OLTP_DATABASE=
OLTP_USERNAME=
OLTP_PASSWORD=
OLTP_RANDOM_SEED=42
OLTP_STARTUP_TIMEOUT_SECONDS=120

# Independent INSERT limits. 0 disables a flow. All durations are milliseconds.
# Junction rows never consume these limits; initial device OS is also automatic.
DEVICE_INSERT_MAX_PER_PERIOD=10
DEVICE_INSERT_PERIOD_MS=60000
DEVICE_INSERT_INTERVAL_MS=100

DEVICE_OS_HISTORY_INSERT_MAX_PER_PERIOD=10
DEVICE_OS_HISTORY_INSERT_PERIOD_MS=60000
DEVICE_OS_HISTORY_INSERT_INTERVAL_MS=100

GENRE_INSERT_MAX_PER_PERIOD=20
GENRE_INSERT_PERIOD_MS=60000
GENRE_INSERT_INTERVAL_MS=100

APP_RELEASE_INSERT_MAX_PER_PERIOD=2
APP_RELEASE_INSERT_PERIOD_MS=60000
APP_RELEASE_INSERT_INTERVAL_MS=100

INSTALLATION_INSERT_MAX_PER_PERIOD=20
INSTALLATION_INSERT_PERIOD_MS=60000
INSTALLATION_INSERT_INTERVAL_MS=100

ARTIST_INSERT_MAX_PER_PERIOD=10
ARTIST_INSERT_PERIOD_MS=60000
ARTIST_INSERT_INTERVAL_MS=100

RELEASE_INSERT_MAX_PER_PERIOD=10
RELEASE_INSERT_PERIOD_MS=60000
RELEASE_INSERT_INTERVAL_MS=100

TRACK_INSERT_MAX_PER_PERIOD=100
TRACK_INSERT_PERIOD_MS=60000
TRACK_INSERT_INTERVAL_MS=100

# UPDATE budget = floor(row count at period start * percentage / 100).
# Each row is updated at most once per period; newly inserted rows are eligible.
# Finite catalogs, OS history and app releases have no UPDATE flow.
INSTALLATION_UPDATE_PERCENT_PER_PERIOD=10
INSTALLATION_UPDATE_PERIOD_MS=60000
INSTALLATION_UPDATE_INTERVAL_MS=500

ARTIST_UPDATE_PERCENT_PER_PERIOD=10
ARTIST_UPDATE_PERIOD_MS=60000
ARTIST_UPDATE_INTERVAL_MS=500

RELEASE_UPDATE_PERCENT_PER_PERIOD=10
RELEASE_UPDATE_PERIOD_MS=60000
RELEASE_UPDATE_INTERVAL_MS=500

TRACK_UPDATE_PERCENT_PER_PERIOD=10
TRACK_UPDATE_PERIOD_MS=60000
TRACK_UPDATE_INTERVAL_MS=500

# Event generator: bootstrap servers use host:port, not http:// or https://.
# This topic must already exist (created by kafka-init); no topic auto-creation.
EVENT_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
EVENT_KAFKA_TOPIC=music-events

# Shared quota counts ALL event types, including session start/end.
# Open sessions continue next period. 0 disables sending. Durations are ms.
EVENT_MAX_PER_PERIOD=100
EVENT_PERIOD_MS=60000
EVENT_INTERVAL_MS=500

EVENT_MAX_ACTIVE_SESSIONS=10
EVENT_SESSION_MIN_TRACKS=1
EVENT_SESSION_MAX_TRACKS=5

# Anonymous sessions never like/dislike. Users and sessions live in memory only.
EVENT_ANONYMOUS_SESSION_PERCENT=20
EVENT_NEW_USER_PERCENT=25
EVENT_USER_POOL_MAX_SIZE=1000
# Sum must not exceed 100; remaining probability means no reaction.
EVENT_LIKE_PERCENT=30
EVENT_DISLIKE_PERCENT=10

EVENT_SOURCE_REFRESH_INTERVAL_MS=5000
EVENT_STARTUP_TIMEOUT_SECONDS=120
# If increased, allow enough Compose stop_grace_period for send plus flush.
EVENT_DELIVERY_TIMEOUT_MS=30000
EVENT_RANDOM_SEED=42

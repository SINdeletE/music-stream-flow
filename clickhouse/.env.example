# ClickHouse Docker deployment (paths are relative to clickhouse/docker-compose.yml)
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8-alpine
ZOOKEEPER_IMAGE=zookeeper:3.7
CLICKHOUSE_CONFIGS_FOLDER=./configs
CLICKHOUSE_DATA_FOLDER=./data
CLICKHOUSE_BIND_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# CLICKHOUSE_ADMIN_USERNAME=admin (no configure variable, only for reference)
CLICKHOUSE_ADMIN_PASSWORD=change-me-before-running

# OLTP Database "music_oltp"
MUSIC_OLTP_HOST=
MUSIC_OLTP_PORT=
MUSIC_OLTP_INTERNAL_PORT=
MUSIC_OLTP_DATABASE=
MUSIC_OLTP_USERNAME=
MUSIC_OLTP_PASSWORD=

# OLTP Database "music_oltp" | seeds generator
MUSIC_OLTP_SEEDS_GENERATOR_HOST=music-oltp
MUSIC_OLTP_SEEDS_GENERATOR_PORT={MUSIC_OLTP_INTERNAL_PORT}
MUSIC_OLTP_SEEDS_GENERATOR_DATABASE={MUSIC_OLTP_DATABASE}
MUSIC_OLTP_SEEDS_GENERATOR_USERNAME={MUSIC_OLTP_USERNAME}
MUSIC_OLTP_SEEDS_GENERATOR_PASSWORD={MUSIC_OLTP_PASSWORD}

# Generated base entity counts. Junction table counts are derived automatically.
MUSIC_OLTP_SEEDS_GENERATOR_RANDOM_SEED=42
MUSIC_OLTP_SEEDS_GENERATOR_DEVICE_COUNT=40
MUSIC_OLTP_SEEDS_GENERATOR_APP_RELEASE_COUNT=12
MUSIC_OLTP_SEEDS_GENERATOR_INSTALLATION_COUNT=200
MUSIC_OLTP_SEEDS_GENERATOR_GENRE_COUNT=20
MUSIC_OLTP_SEEDS_GENERATOR_ARTIST_COUNT=120
MUSIC_OLTP_SEEDS_GENERATOR_RELEASE_COUNT=80
MUSIC_OLTP_SEEDS_GENERATOR_TRACK_COUNT=500

MUSIC_OLTP_SEEDS_GENERATOR_INTERVAL_MS=10000

# Airflow
AIRFLOW_IMAGE_NAME=slim-latest-python3.14
AIRFLOW_VERSION=3.3.1
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=

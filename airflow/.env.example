# Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.1
AIRFLOW_VERSION=3.3.1
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Pipeline | OLTP Database "music_oltp" configuration
MUSIC_OLTP_DB_USER=${MUSIC_OLTP_USERNAME}
MUSIC_OLTP_DB_PASSWORD=${MUSIC_OLTP_PASSWORD}
MUSIC_OLTP_DB_NAME=${MUSIC_OLTP_DATABASE}
MUSIC_OLTP_DB_HOST=${MUSIC_OLTP_HOST}
MUSIC_OLTP_DB_PORT=${MUSIC_OLTP_PORT}

# Pipeline | OLTP transport info
MUSIC_OLTP_BATCH_SIZE=1000

# Pipeline | DWH Database "music_dwh" configuration
MUSIC_DWH_DB_USER=default
MUSIC_DWH_DB_PASSWORD=
MUSIC_DWH_DB_NAME=music_dwh
MUSIC_DWH_DB_HOST=clickhouse01
MUSIC_DWH_DB_PORT=8123
